rules_version = '2';

// Storage 보안 규칙: 자기 동화의 그림·목소리 파일만 올리고 지울 수 있어요.
//   users/{uid}/stories/{storyId}/images/page-{n}.jpg  (그림, 5MB 까지)
//   users/{uid}/stories/{storyId}/audio/page-{n}.mp3   (목소리, 5MB 까지)
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/stories/{storyId}/{kind}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isAllowedFile() {
        return request.resource.size < 5 * 1024 * 1024
          && ((kind == 'images' && request.resource.contentType.matches('image/.*'))
           || (kind == 'audio' && request.resource.contentType.matches('audio/.*')));
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isAllowedFile();
    }
  }
}
